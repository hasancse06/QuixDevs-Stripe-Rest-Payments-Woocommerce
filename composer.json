{
  "name": "quixdevs/quixdevs-stripe-rest-payments",
  "description": "REST API Payment Integration for WooCommerce Stripe",
  "type": "wordpress-plugin",
  "license": "MIT",
  "require": {"php": ">=8.2"},
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "wp-coding-standards/wpcs": "^3.2",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
    "phpstan/phpstan": "^2.1",
    "php-stubs/wordpress-stubs": "^6.9",
    "php-stubs/woocommerce-stubs": "^10.9"
  },
  "autoload": {"psr-4": {"QuixDevs\\StripeRestPayments\\": "includes/"}},
  "config": {"allow-plugins": {"dealerdirect/phpcodesniffer-composer-installer": true}, "sort-packages": true},
  "scripts": {
    "test": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration",
    "lint": "phpcs",
    "analyse": "phpstan analyse --memory-limit=1G",
    "package": "python3 tools/package.py"
  }
}
